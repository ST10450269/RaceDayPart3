@model LoginForm
@{ViewData["Title"]="Log in";}
<div class="surface auth-card"><div class="kicker">WELCOME BACK</div><h1 class="h2 mt-2 mb-4">Sign in to RaceDay</h1><form asp-action="Login" method="post"><div asp-validation-summary="All" class="form-validation"></div><div class="mb-3"><label asp-for="Email" class="field-title"></label><input asp-for="Email" class="form-control" autocomplete="email"/></div><div class="mb-4"><label asp-for="Password" class="field-title"></label><input asp-for="Password" class="form-control" type="password" autocomplete="current-password"/></div><button class="button-primary w-100" type="submit">Log in</button></form><p class="mt-4 mb-0 muted">New to RaceDay? <a asp-action="Register">Create an account</a></p></div>
