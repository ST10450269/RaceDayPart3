@model ProfileForm
@{ViewData["Title"]="My profile";}
<div class="section-title"><div><div class="kicker">MY ACCOUNT</div><h1 class="h2">Profile settings</h1></div></div>
<div class="row g-4"><div class="col-md-7"><div class="surface"><h2>Personal details</h2><form asp-action="Profile" method="post"><div asp-validation-summary="All" class="form-validation"></div><div class="mb-3"><label class="field-title">Email address (read only)</label><input value="@Model.Email" class="form-control" disabled/></div><div class="mb-3"><label asp-for="FullName" class="field-title">Full name</label><input asp-for="FullName" class="form-control"/></div><div class="mb-3"><label asp-for="Phone" class="field-title"></label><input asp-for="Phone" class="form-control"/></div><div class="mb-4"><label asp-for="City" class="field-title"></label><input asp-for="City" class="form-control"/></div><button type="submit" class="button-primary">Save changes</button></form></div></div>
<div class="col-md-5"><div class="surface"><h2>Profile picture</h2>@if(Model.HasProfilePicture){<img src="@Url.Action("Profile","Media")" alt="Your profile picture" width="130" height="130" style="border-radius:50%;object-fit:cover" class="mb-3"/>}<form asp-action="Picture" method="post" enctype="multipart/form-data"><label class="field-title" for="file">Upload an image (JPG, PNG or WEBP; max 5 MB)</label><input type="file" name="file" id="file" accept="image/jpeg,image/png,image/webp" class="form-control mb-3" required/><button class="button-primary" type="submit">Upload picture</button></form><p class="tiny muted mt-3">Images are uploaded by the RaceDay API to Azure Blob Storage.</p></div></div></div>
