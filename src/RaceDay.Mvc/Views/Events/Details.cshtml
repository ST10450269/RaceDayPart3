@model EventDetailsViewModel
@{var e=Model.Event;var role=Context.Session.GetString("Role");var owns=role=="Organiser"&&e.OrganiserId==Context.Session.GetInt32("UserId");ViewData["Title"]=e.Name;}
<div class="mb-3"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">← All events</a></div>
@if(e.HasBanner){<img src="@Url.Action("Banner","Media",new{id=e.Id})" class="banner mb-4" alt="Event banner"/>}
<div class="row g-4"><div class="col-lg-8"><div class="kicker">@e.EventType / @e.DistanceKm KM</div><h1 class="mt-2">@e.Name</h1><p class="lead muted">@e.Description</p><div class="row g-3 mt-3"><div class="col-sm-6"><div class="stat"><div class="kicker">WHEN</div><strong class="h5">@e.DateUtc.ToString("dd MMM yyyy")</strong><div>@e.DateUtc.ToString("HH:mm") UTC</div></div></div><div class="col-sm-6"><div class="stat"><div class="kicker">WHERE</div><strong class="h5">@e.Location</strong><div>@e.EventType • @e.DistanceKm km</div></div></div></div>
<div class="surface mt-4"><h2>Race categories</h2>@if(Model.Categories.Count==0){<p class="muted">No categories are available yet.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Category</th><th>Age</th><th>Distance</th><th></th></tr></thead><tbody>@foreach(var c in Model.Categories){<tr><td>@c.Name</td><td>@(c.MinAge?.ToString()??"Any") - @(c.MaxAge?.ToString()??"Any")</td><td>@(c.DistanceKm?.ToString()??"—") km</td><td>@if(role=="Participant"){<form asp-controller="Enrolments" asp-action="Enter" method="post"><input type="hidden" name="eventId" value="@e.Id"/><input type="hidden" name="categoryId" value="@c.Id"/><button type="submit" class="btn btn-success btn-sm" disabled="@(e.DateUtc<=DateTime.UtcNow)">Enter</button></form>}else if(owns){<form asp-controller="Categories" asp-action="Delete" method="post"><input type="hidden" name="id" value="@c.Id"/><input type="hidden" name="eventId" value="@e.Id"/><button type="submit" class="btn btn-link text-danger p-0">Remove</button></form>}</td></tr>}</tbody></table></div>}
@if(role is null){<p class="muted">Please <a asp-controller="Account" asp-action="Login">log in</a> as a Participant to enter this event.</p>}
</div></div>
<div class="col-lg-4">@if(owns){<div class="surface mb-3"><h2>Event controls</h2><div class="d-grid gap-2 mb-3"><a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@e.Id">Edit event details</a><a class="btn btn-outline-dark" asp-controller="Enrolments" asp-action="Event" asp-route-id="@e.Id">View enrolments (@e.EnrolmentCount)</a><a class="btn btn-outline-dark" asp-controller="Results" asp-action="Event" asp-route-id="@e.Id">Manage results</a></div><form asp-action="Banner" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="@e.Id"/><label for="banner" class="field-title">Event banner image</label><input id="banner" name="file" type="file" accept="image/jpeg,image/png,image/webp" class="form-control mb-2" required/><button class="button-primary" type="submit">Upload banner</button></form></div><div class="surface"><h2>Add race category</h2><form asp-controller="Categories" asp-action="Create" method="post"><input type="hidden" name="EventId" value="@e.Id"/><label class="field-title">Name</label><input name="Name" class="form-control mb-2" placeholder="10 km Open" required/><label class="field-title">Min age (optional)</label><input type="number" min="0" name="MinAge" class="form-control mb-2"/><label class="field-title">Max age (optional)</label><input type="number" min="0" name="MaxAge" class="form-control mb-2"/><label class="field-title">Distance km (optional)</label><input type="number" min="0.1" step="0.1" name="DistanceKm" class="form-control mb-3"/><button class="button-primary" type="submit">Add category</button></form></div>}else{<div class="surface"><h2>Race entry</h2><p class="muted">Pick a category to register for this race.</p>@if(role=="Participant"){<p>Welcome, athlete! Select the green Enter button next to your category.</p>}else{<a asp-controller="Account" asp-action="Register" class="button-primary d-inline-block text-decoration-none">Join as a participant</a>}</div>}</div></div>
