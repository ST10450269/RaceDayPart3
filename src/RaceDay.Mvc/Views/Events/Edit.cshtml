@model EventForm
@{var editing=Model.Id!=0;ViewData["Title"]=editing?"Edit event":"Create event";}
<div class="section-title"><div><div class="kicker">ORGANISER / EVENT MANAGEMENT</div><h1 class="h2">@(editing?"Edit event":"Create a race event")</h1></div></div>
<div class="surface" style="max-width:840px"><form asp-action="Save" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="form-validation"></div><div class="mb-3"><label class="field-title" asp-for="Name">Event name</label><input asp-for="Name" class="form-control"/></div><div class="mb-3"><label class="field-title" asp-for="Description"></label><textarea asp-for="Description" rows="4" class="form-control"></textarea></div><div class="row g-3"><div class="col-md-6"><label class="field-title" asp-for="DateUtc">Event date and time (UTC)</label><input asp-for="DateUtc" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control"/></div><div class="col-md-6"><label class="field-title" asp-for="Location"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-6"><label class="field-title" asp-for="DistanceKm">Distance in kilometres</label><input asp-for="DistanceKm" type="number" step="0.1" class="form-control"/></div><div class="col-md-6"><label class="field-title" asp-for="EventType">Event type</label><select asp-for="EventType" class="form-select"><option value="Run">Run</option><option value="Walk">Walk</option><option value="Cycle">Cycle</option></select></div></div><div class="mt-4 d-flex gap-3"><button class="button-primary" type="submit">Save event</button><a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></div>
