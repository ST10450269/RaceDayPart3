@model List<EnrolmentDto>
@{ViewData["Title"]="Enrolment management";}
<div class="section-title"><div><div class="kicker">ORGANISER / ENROLMENTS</div><h1 class="h2">Participant entries</h1></div><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></div>
<div class="surface">@if(Model.Count==0){<div class="empty">No participants have entered yet.</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Entered</th><th>Status</th><th>Change status</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName<div class="tiny muted">@e.ParticipantEmail</div></td><td>@e.CategoryName</td><td>@e.EnteredAtUtc.ToString("dd MMM yyyy")</td><td><span class="status-label status-@e.Status">@e.Status</span></td><td><form asp-action="Status" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="eventId" value="@e.EventId"/><select name="status" class="form-select form-select-sm"><option selected="@(e.Status=="Confirmed")">Confirmed</option><option selected="@(e.Status=="Pending")">Pending</option></select><button class="btn btn-sm btn-outline-dark">Save</button></form></td></tr>}</tbody></table></div>}</div>
