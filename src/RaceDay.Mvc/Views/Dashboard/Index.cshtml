@model OrganiserDashboardViewModel
@{ViewData["Title"]="Organiser dashboard";}
<div class="section-title"><div><div class="kicker">ORGANISER CONTROL ROOM</div><h1 class="h2">My race events</h1></div><a class="button-primary text-decoration-none" asp-controller="Events" asp-action="Create">+ Create event</a></div>
<div class="row g-3 mb-4"><div class="col-sm-4"><div class="stat"><span class="muted">My events</span><strong>@Model.Events.Count</strong></div></div><div class="col-sm-4"><div class="stat"><span class="muted">Total enrolments</span><strong>@Model.EnrolmentCounts.Values.Sum()</strong></div></div><div class="col-sm-4"><div class="stat"><span class="muted">Upcoming events</span><strong>@Model.Events.Count(x=>x.DateUtc>=DateTime.UtcNow)</strong></div></div></div>
<div class="surface"><h2 class="mb-3">Event management</h2>@if(Model.Events.Count==0){<div class="empty">You have no events yet. Create your first one.</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Entries</th><th>Management</th></tr></thead><tbody>@foreach(var e in Model.Events){<tr><td><strong>@e.Name</strong><div class="tiny muted">@e.Location / @e.EventType</div></td><td>@e.DateUtc.ToString("dd MMM yyyy")</td><td>@Model.EnrolmentCounts[e.Id]</td><td><div class="d-flex flex-wrap gap-2"><a asp-controller="Events" asp-action="Details" asp-route-id="@e.Id">Details</a><a asp-controller="Events" asp-action="Edit" asp-route-id="@e.Id">Edit</a><a asp-controller="Enrolments" asp-action="Event" asp-route-id="@e.Id">Entries</a><a asp-controller="Results" asp-action="Event" asp-route-id="@e.Id">Results</a><form asp-controller="Events" asp-action="Delete" method="post" onsubmit="return confirm('Delete this event?');"><input type="hidden" name="id" value="@e.Id"/><button type="submit" class="btn btn-link text-danger p-0">Delete</button></form></div></td></tr>}</tbody></table></div>}</div>
