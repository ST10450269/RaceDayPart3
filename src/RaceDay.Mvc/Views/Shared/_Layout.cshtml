@{var role=Context.Session.GetString("Role");var logged=Context.Session.GetInt32("UserId") is not null;var full=Context.Session.GetString("FullName")??"";}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] | RaceDay</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyTtucWfIeRLpqAIiC2UeGfN7RzXDG7" crossorigin="anonymous"/>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<header class="topbar"><nav class="container navbar navbar-expand-lg"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> RACEDAY<span class="brand-accent">.</span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
<div id="nav" class="collapse navbar-collapse"><div class="navbar-nav ms-auto gap-lg-2 align-items-lg-center">
<a class="nav-link" asp-controller="Home" asp-action="Index">Explore events</a>
@if(role=="Organiser"){<a class="nav-link" asp-controller="Dashboard" asp-action="Index">My dashboard</a><a class="nav-link" asp-controller="Events" asp-action="Create">Create event</a>}
@if(role=="Participant"){<a class="nav-link" asp-controller="Enrolments" asp-action="Mine">My events</a><a class="nav-link" asp-controller="Results" asp-action="Mine">My results</a>}
@if(logged){<a class="nav-link" asp-controller="Account" asp-action="Profile">@full</a><form asp-controller="Account" asp-action="Logout" method="post" class="d-inline"><button class="btn btn-outline-dark btn-sm" type="submit">Log out</button></form>}
else{<a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a><a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a>}
</div></div></nav></header>
<main class="container page-content">
@if(TempData["Notice"] is string note){<div class="alert alert-success" role="status">@note</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
@RenderBody()
</main><footer class="footer"><div class="container d-flex justify-content-between"><span>RACEDAY / MOVE WITH PURPOSE</span><span>Built for South African athletes</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
@await RenderSectionAsync("Scripts",required:false)</body></html>
