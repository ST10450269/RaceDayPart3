@model List<EventDto>
@{ViewData["Title"]="Find your next challenge";}
<section class="hero"><div><div class="kicker" style="color:#d6f152">SOUTH AFRICA'S RACE COMMUNITY</div><h1>Every finish line<br/>starts here.</h1><p class="lead mt-3">Discover road races, cycle challenges and community walks. Join an event, track your entries and celebrate your results.</p><a class="btn btn-lime mt-3 px-4 py-3" href="#events">Explore events</a></div></section>
<div class="section-title" id="events"><div><div class="kicker">THE CALENDAR</div><h2>Upcoming events</h2></div><span class="muted">@Model.Count event(s) found</span></div>
<form method="get" asp-action="Index" class="row g-2 mb-4"><div class="col-md-6"><input class="form-control" name="search" placeholder="Search by name or location" value="@ViewBag.Search"/></div><div class="col-md-3"><select class="form-select" name="type"><option value="">All event types</option>@foreach(var t in new[]{"Run","Walk","Cycle"}){<option value="@t" selected="@(ViewBag.Type==t)">@t</option>}</select></div><div class="col-md-3"><button class="button-primary w-100" type="submit">Find events</button></div></form>
@if(ViewBag.Error is string err){<div class="alert alert-warning">@err</div>}
@if(Model.Count==0){<div class="empty">No matching upcoming events. Try a different search.</div>}
<div class="row g-4">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><article class="event-card"><div class="event-art">@if(e.HasBanner){<img src="@Url.Action("Banner","Media",new{id=e.Id})" alt="Banner for @e.Name"/>}else{<span>GO.</span>}</div><div class="event-body"><div class="d-flex gap-2 flex-wrap mb-3"><span class="pill">@e.EventType</span><span class="pill">@e.DistanceKm km</span></div><h3>@e.Name</h3><p class="mb-2">@e.Location</p><p class="mb-4">@e.DateUtc.ToString("dddd, dd MMMM yyyy")</p><a class="event-link" asp-controller="Events" asp-action="Details" asp-route-id="@e.Id">Event details →</a></div></article></div>}</div>
