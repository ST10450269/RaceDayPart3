@model List<ResultDto>
@{ViewData["Title"]="My results";}
<div class="section-title"><div><div class="kicker">PERSONAL PERFORMANCE</div><h1 class="h2">My race history</h1></div></div>
<div class="surface">@if(Model.Count==0){<div class="empty">No published results yet. Completed race times will appear here.</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var r in Model){<tr><td><strong>@r.EventName</strong></td><td>@r.EventDateUtc.ToString("dd MMM yyyy")</td><td>@r.CategoryName</td><td>@TimeSpan.FromSeconds(r.FinishTimeSeconds).ToString(@"hh\:mm\:ss")</td><td>@r.Position / @r.TotalFinishers finishers</td></tr>}</tbody></table></div>}</div>
