@model EventResultsViewModel
@{ViewData["Title"]="Publish race results";}
<div class="section-title"><div><div class="kicker">ORGANISER / RACE RESULTS</div><h1 class="h2">@Model.Event.Name</h1></div><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></div>
@if(Model.Event.DateUtc>DateTime.UtcNow){<div class="alert alert-warning">Results can only be published after the event has finished.</div>}
<div class="surface"><h2>Enrolled participants</h2>@if(Model.Enrolments.Count==0){<div class="empty">No race entries available.</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Finish time (HH:mm:ss)</th><th>Position</th><th>Finishers</th><th>Publish</th></tr></thead><tbody>@foreach(var e in Model.Enrolments){var existing=Model.Results.FirstOrDefault(r=>r.EnrolmentId==e.Id);<tr><td>@e.ParticipantName</td><td>@e.CategoryName</td><td><span class="status-label status-@e.Status">@e.Status</span></td><td colspan="4"><form asp-action="Save" method="post" class="row gx-2 gy-2"><input type="hidden" name="EventId" value="@Model.Event.Id"/><input type="hidden" name="EnrolmentId" value="@e.Id"/><div class="col-sm-4"><input name="FinishTime" class="form-control form-control-sm" value="@(existing is null?"00:45:00":TimeSpan.FromSeconds(existing.FinishTimeSeconds).ToString(@"hh\:mm\:ss"))" required/></div><div class="col-sm-2"><input name="Position" type="number" min="1" class="form-control form-control-sm" value="@(existing?.Position??1)" required/></div><div class="col-sm-3"><input name="TotalFinishers" type="number" min="1" class="form-control form-control-sm" value="@(existing?.TotalFinishers??Model.Enrolments.Count)" required/></div><div class="col-sm-3"><button type="submit" class="btn btn-sm btn-success" disabled="@(e.Status!="Confirmed"||Model.Event.DateUtc>DateTime.UtcNow)">@(existing is null?"Publish":"Update")</button></div></form></td></tr>}</tbody></table></div>}</div>
