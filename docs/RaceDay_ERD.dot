digraph RaceDay {
graph [bgcolor="#FCFBF8", rankdir=LR, nodesep="0.55", ranksep="1.0", pad="0.4", splines=polyline, fontname="Arial"];
node [shape=plain, fontname="Arial"];
edge [color="#476b60", arrowsize=.75, penwidth=1.5, fontsize=11, fontname="Arial"];
Roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#618c79"><TR><TD BGCOLOR="#183a32"><FONT COLOR="white" POINT-SIZE="16"><B>Roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">PK </FONT>Id : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">UQ </FONT>Name : nvarchar(30)</TD></TR></TABLE>>];
Users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#618c79"><TR><TD BGCOLOR="#183a32"><FONT COLOR="white" POINT-SIZE="16"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">PK </FONT>Id : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">FK </FONT>RoleId : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">UQ </FONT>Email : nvarchar(200)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">FullName : nvarchar(100)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">PasswordHash : nvarchar(500)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">Phone : nvarchar(30)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">City : nvarchar(100)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">ProfileImageName : nvarchar(260)?</TD></TR></TABLE>>];
Events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#618c79"><TR><TD BGCOLOR="#183a32"><FONT COLOR="white" POINT-SIZE="16"><B>Events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">PK </FONT>Id : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">FK </FONT>OrganiserId : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">Name : nvarchar(120)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">Description : nvarchar(1500)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">DateUtc : datetime2</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">Location : nvarchar(200)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">DistanceKm : decimal(8,2)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">EventType : nvarchar(12)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">BannerImageName : nvarchar(260)?</TD></TR></TABLE>>];
Categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#618c79"><TR><TD BGCOLOR="#183a32"><FONT COLOR="white" POINT-SIZE="16"><B>Categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">PK </FONT>Id : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">FK </FONT>EventId : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">UQ </FONT>EventId + Name</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">Name : nvarchar(100)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">MinAge : int?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">MaxAge : int?</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">DistanceKm : decimal(8,2)?</TD></TR></TABLE>>];
Enrolments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#618c79"><TR><TD BGCOLOR="#183a32"><FONT COLOR="white" POINT-SIZE="16"><B>Enrolments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">PK </FONT>Id : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">FK </FONT>EventId : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">FK </FONT>ParticipantId : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">FK </FONT>CategoryId : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">UQ </FONT>EventId + ParticipantId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">Status : nvarchar(20)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">EnteredAtUtc : datetime2</TD></TR></TABLE>>];
Results [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#618c79"><TR><TD BGCOLOR="#183a32"><FONT COLOR="white" POINT-SIZE="16"><B>Results</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">PK </FONT>Id : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3efe6"><FONT COLOR="#174d3e">FK UQ </FONT>EnrolmentId : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">FinishTimeSeconds : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">Position : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">TotalFinishers : int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">PublishedAtUtc : datetime2</TD></TR></TABLE>>];
Roles -> Users [label="1 : many"];
Users -> Events [label="1 : many (organiser)"];
Users -> Enrolments [label="1 : many (participant)"];
Events -> Categories [label="1 : many"];
Events -> Enrolments [label="1 : many"];
Categories -> Enrolments [label="1 : many"];
Enrolments -> Results [label="1 : 0..1"];
}
